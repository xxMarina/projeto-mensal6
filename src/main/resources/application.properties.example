# =============================================================
# Modelo de configuração para desenvolvimento local
# Copie este arquivo para application.properties e ajuste as credenciais:
# cp src/main/resources/application.properties.example src/main/resources/application.properties
# =============================================================

# ── Servidor ─────────────────────────────────────────────────
server.port=8080

# ── Banco de Dados MySQL ──────────────────────────────────────
spring.datasource.url=jdbc:mysql://localhost:3306/marmitech_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
spring.datasource.username=marmitech_user
spring.datasource.password=marmitech_pass
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ── JPA / Hibernate ──────────────────────────────────────────
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# ── Autenticação JWT ─────────────────────────────────────────
# Chave secreta de 256 bits para assinatura HMAC-SHA256 (mude em produção)
jwt.secret=marmitechSecretKeyParaAssinaturaJwtSuperSegura2026Marmitech
# Tempo de expiração em milissegundos (86400000 ms = 24 horas)
jwt.expiration=86400000

# ── Logs ─────────────────────────────────────────────────────
logging.level.root=WARN
logging.level.com.marmitech=INFO
